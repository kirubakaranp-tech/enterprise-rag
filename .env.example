# Copy this file to .env and fill in your own values. .env is never committed.

# Groq (free plan) for routing and answers
OPENAI_API_KEY=your-groq-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# PostgreSQL: the admin login is only used by setup_db.py
DATABASE_ADMIN_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres
READONLY_DATABASE_URL=postgresql://hr_readonly:CHOOSE_A_PASSWORD@localhost:5432/hr_db
